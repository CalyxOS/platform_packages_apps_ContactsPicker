<resources>
    <!-- The Contacts Picker app label. [CHAR LIMIT=25] -->
    <string name="contacts_picker_app_label">Contacts Picker</string>

    <!-- The title of the chooser activity launched for apps targeting SDK below 37. -->
    <string name="contacts_picker_chooser_activity_title">Contacts Picker</string>
    <!-- Text shown to the user in a Toast when no app can handle the chooser intent. -->
    <string name="contacts_picker_chooser_activity_no_app_can_handle_action">No application can handle this action.</string>

    <!-- Placeholder text shown in the search box. [CHAR LIMIT=25] -->
    <string name="contacts_picker_top_bar_search_placeholder_hint">Search</string>
    <!--Content description for the search icon button in the collapsed search bar. Tapping it
        expands the search top bar. [CHAR LIMIT=NONE] -->
    <string name="contacts_picker_top_bar_search_icon_content_description">Search</string>
    <!--Content description for the 'X' icon button in the expanded search bar. Tapping it clears
        the text that has been entered in the search field. [CHAR LIMIT=NONE] -->
    <string name="contacts_picker_top_bar_search_clear_text_content_description">Clear search text</string>
    <!--Content description for the back arrow icon button in the expanded search bar. Tapping it
        closes the search field. [CHAR LIMIT=NONE] -->
    <string name="contacts_picker_top_bar_search_arrow_back_content_description">Close search</string>
    <!--Content description for the more options icon on primary contacts list top bar [CHAR LIMIT=NONE] -->
    <string name="contacts_picker_top_bar_more_options_content_description">More options</string>
    <!-- The title of the "Favorites" section in the contacts list. -->
    <string name="contacts_picker_favorites_header">Favorites</string>
    <!--Content description for the "Favorites" section header icon. [CHAR LIMIT=NONE] -->
    <string name="favorites_header_icon_content_description">Star icon</string>
    <!--Content description for the emoji icon that is the section header for special characters. [CHAR LIMIT=NONE] -->
    <string name="emoji_header_icon_content_description">Smile icon</string>
    <!--Content description for the profile switcher icon button in the top bar. Tapping it
        expands the profile switcher. [CHAR LIMIT=NONE] -->
    <string name="profile_switcher_content_description">Switch profile</string>
    <!--Content description for the privacy icon button in the top bar. Tapping it opens the privacy
        information banner. [CHAR LIMIT=NONE] -->
    <string name="privacy_info_content_description">Privacy information</string>
    <!--Content description for the fast scroller's handle, which lets the user scroll quickly through a list.
        [CHAR_LIMIT=NONE] -->
    <string name="fast_scroller_handle_content_description">Fast scroller handle</string>
    <!-- Content description for the avatar profile picture of the contact. [CHAR LIMIT=NONE] -->
    <string name="contact_avatar_profile_picture_content_description">Contact profile picture</string>
    <!-- Content description for the avatar initial of the contact when profile picture does not
        exist. [CHAR LIMIT=NONE] -->
    <string name="contact_avatar_initial_content_description">Contact initial</string>
    <!-- Content description for the drop down button to expand contacts with multiple email
        addresses or phone numbers. [CHAR LIMIT=NONE] -->
    <string name="contact_item_expand_button_content_description">Expand</string>
    <!-- Content description for the button to collapse the expanded contacts with multiple email
        addresses or phone numbers. [CHAR LIMIT=NONE] -->
    <string name="contact_item_collapse_button_content_description">Collapse</string>
    <!-- Content description for the phone icon in the expanded contacts with multiple phone
        numbers. [CHAR LIMIT=NONE] -->
    <string name="contact_item_phone_icon_content_description">Phone</string>
    <!-- Content description for the email icon in the expanded contacts with multiple email
        addresses. [CHAR LIMIT=NONE] -->
    <string name="contact_item_email_icon_content_description">Email</string>

    <!-- Count of emails shown in the contact item with multiple emails when none are selected.
        [CHAR LIMIT=NONE] -->
    <string name="contact_item_emails_count">
        {count, plural,
        =1 {# email}
        other {# emails}}
    </string>
    <!-- Count of phone numbers shown in the collapsed contact item with multiple numbers when none
        are selected. [CHAR LIMIT=NONE] -->
    <string name="contact_item_phones_count">
        {count, plural,
        =1 {# phone number}
        other {# phone numbers}}
    </string>
    <!-- Count of selected emails shown in the contact item with multiple emails when one or more
        are selected. [CHAR LIMIT=NONE] -->
    <string name="contact_item_emails_selected_count">
        {total_count, plural,
        =1 {{selected_count} of # email}
        other {{selected_count} of # emails}}
    </string>
    <!-- Count of selected phone numbers shown in the contact item with multiple numbers when one or
        more are selected [CHAR LIMIT=NONE] -->
    <string name="contact_item_phones_selected_count">
        {total_count, plural,
        =1 {{selected_count} of # phone number}
        other {{selected_count} of # phone numbers}}
    </string>

    <!-- Message shown in to the user when trying to select contacts above the limit. [CHAR LIMIT=40] -->
    <string name="contacts_selection_limit_reached_message">
        {count, plural,
        =1 {Can share only # contact at a time}
        other {Can share only # contacts at a time}}
    </string>
    <!-- Content description for the checkmark icon that replaces the avatar when a contact is
        selected. The parameter is the contact's name. [CHAR LIMIT=NONE] -->
    <string name="contact_item_selected_content_description">%1$s selected</string>
    <!-- Content description for the button that clears all selected contacts in the selection bar.
        [CHAR LIMIT=NONE] -->
    <string name="selection_bottom_bar_clear_button_content_description">Clear selection</string>
    <!-- Label for the button in the selection bar that allows the user to preview their selected
        contacts. [CHAR LIMIT=20] -->
    <string name="selection_bottom_bar_preview_button_label">Preview</string>
    <!-- Label for the button in the selection bar that allows the user to go back from the preview
        page. [CHAR LIMIT=20] -->
    <string name="selection_bottom_bar_back_button_label">Back</string>
    <!-- Label for the button in the selection bar that confirms the user's selection and closes the picker.
        [CHAR LIMIT=20] -->
    <string name="selection_bottom_bar_done_button_label">Done</string>

    <!-- Description for the privacy banner shown at the top of the contact picker. %1$s is the app name. -->
    <string name="privacy_banner_description">"%1$s will only have access to info from the contacts you select"</string>
    <!-- Text for the "More Details" button on the privacy banner. -->
    <string name="privacy_banner_more_details">"More Details"</string>
    <!-- Text for the "Dismiss" button on the privacy banner. -->
    <string name="privacy_banner_dismiss">"Dismiss"</string>

    <!-- Content description for the back button in the privacy details top bar -->
    <string name="title_top_bar_back_button_content_description">Back</string>

    <!-- Preview screen title at the top of the page. [CHAR LIMIT=20] -->
    <string name="preview_screen_title">Preview</string>

    <!-- The default fallback name to use for the calling application. -->
    <string name="default_calling_app_name">This app</string>

    <!-- Text for the privacy menu in the top bar of Contacts List Screen -->
    <string name="privacy_details_menu_label">Your contacts\' privacy</string>
</resources>
