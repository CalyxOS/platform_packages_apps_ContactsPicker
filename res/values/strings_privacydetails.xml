<resources>
    <!-- Header text for the privacy details top bar -->
    <string name="privacy_details_top_bar_header">Your contacts\' privacy</string>

    <!--
      Description text on the privacy details screen, explaining what contact
      information will be shared. The %1$s placeholder will be replaced by the
      name of the app requesting the contact.
    -->
    <string name="privacy_details_description">
        When you select a contact, %1$s will have access to the following info from your device contacts.\n\nIf you make any updates to the contact info, %1$s won’t have access to the changes.
    </string>

    <!--
      Header text for the list of contact data fields on the privacy details screen.
    -->
    <string name="privacy_details_contact_data_fields_list_header">Contact info can include details such as:</string>

    <!--
      Header text for the "Name" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_name_header">Name</string>

    <!--
      Header text for the "Phone numbers" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_phone_header">Phone numbers</string>

    <!--
      Header text for the "Email addresses" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_email_header">Email addresses</string>

    <!--
      Header text for the "Addresses" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_address_header">Addresses</string>

    <!--
      Header text for the "Company" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_organization_header">Company</string>

    <!--
      Header text for the "Related people" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_related_people_header">Related people</string>

    <!--
      Header text for the "Birthday" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_birthday_header">Birthday</string>

    <!--
      Header text for the "Website" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_website_header">Website</string>

    <!--
      Header text for the "Nickname" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_nickname_header">Nickname</string>

    <!--
      Header text for the "Photo" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_photo_header">Profile picture</string>

    <!--
      Header text for the "Contact group" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_group_header">Contact group</string>

    <!--
      Header text for the "Contact preferences" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_preferences_header">Some contact preferences</string>
    <!--
      Description for the "Contact preferences" contact data field on the privacy details screen.
    -->
    <string name="privacy_details_data_field_preferences_description">Includes a contact’s favorite status and whether they’re sent to voicemail</string>

